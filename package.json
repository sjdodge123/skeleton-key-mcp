{
  "name": "skeleton-key-mcp",
  "version": "0.1.0",
  "description": "MCP server that unlocks your homelab: read logs everywhere, execute changes with approval, backed by a scoped credential vault.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjdodge123/skeleton-key-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sjdodge123/skeleton-key-mcp/issues"
  },
  "homepage": "https://github.com/sjdodge123/skeleton-key-mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "skeleton-key": "./dist/server.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^11.8.0",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.4",
    "ssh2": "^1.16.0",
    "undici": "^8.12.3",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/libsodium-wrappers-sumo": "^0.8.2",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/ssh2": "^1.15.6",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
